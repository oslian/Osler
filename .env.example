# Copy to .env and fill in locally. .env is git-ignored; never commit real values.
# Every variable is optional: with none of them set the demo runs in fixture mode
# on 127.0.0.1:5000 with its SQLite ledger under var/.

# ---- server ----------------------------------------------------------------
OSLIAN_HOST=127.0.0.1
OSLIAN_PORT=5000
OSLIAN_STREAM_DB=var/oslian_stream.sqlite3

# ---- stream event log (printed to the console that runs the server) --------
OSLIAN_STREAM_LOG=events
OSLIAN_STREAM_LOG_FORMAT=pretty
OSLIAN_STREAM_LOG_PAYLOAD=summary

# ---- WholeBody runtime -----------------------------------------------------
# fixture = the pinned release contract, fail-closed, no model process.
# release = run the pinned release checkout in a worker subprocess.
OSLIAN_WHOLEBODY_RUNTIME=fixture
# Defaults to the submodule at backend/research/wholebody-jepa. Set this only to
# point at a different working copy of the SAME approved commit.
OSLIAN_WHOLEBODY_RELEASE_DIR=
# Interpreter that can import that checkout (needs scikit-learn 1.7.2).
OSLIAN_WHOLEBODY_PYTHON=
# Dependency overlay prepended to that interpreter's path.
OSLIAN_WHOLEBODY_PYTHONPATH=

# ---- Epic FHIR boundary (contract only; nothing is read from here today) ----
OSLIAN_EPIC_PRIVATE_KEY_PEM=

# ---- Medication Safety free-text parsing and chat (optional) ---------------
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
