{
  "schema": "oslian.organ-variable-map.v1",
  "basis": "Demo-approved anatomical attribution of WholeBody variables, drafted from standard physiology references for this research dashboard. It is an explicit many-to-many map, not a validated ontology and not the checkpoint's functional modules. It stands in until osler_jepa.organ_schema.canonical_target_organ_membership exists in a formal release.",
  "organs": [
    {"id": "brain", "label": "Brain", "variables": []},
    {"id": "thyroid", "label": "Thyroid", "variables": ["tsh", "free_t4"]},
    {"id": "lungs", "label": "Lungs", "variables": ["o2sat", "respiratory_rate", "ph"]},
    {"id": "heart", "label": "Heart", "variables": ["heart_rate", "map", "troponin_i", "ck_mb", "bnp"]},
    {"id": "blood_vessels", "label": "Blood vessels", "variables": ["map", "lactate", "heart_rate"]},
    {"id": "liver", "label": "Liver", "variables": ["albumin", "alt", "ast", "alkaline_phos", "bilirubin", "bilirubin_direct", "inr", "ptt", "fibrinogen", "total_protein", "prealbumin", "ldh", "triglycerides"]},
    {"id": "stomach", "label": "Stomach", "variables": []},
    {"id": "pancreas", "label": "Pancreas", "variables": ["amylase", "lipase", "glucose"]},
    {"id": "spleen", "label": "Spleen", "variables": ["platelets", "hemoglobin"]},
    {"id": "adrenal_glands", "label": "Adrenal glands", "variables": ["cortisol", "sodium", "potassium"]},
    {"id": "kidneys", "label": "Kidneys", "variables": ["creatinine", "bun", "urine_output", "potassium", "sodium", "chloride", "bicarbonate", "anion_gap", "phosphate", "magnesium", "calcium", "ionized_calcium", "uric_acid", "serum_osmolality", "ph"]},
    {"id": "intestines", "label": "Intestines", "variables": []},
    {"id": "bone_marrow", "label": "Bone marrow", "variables": ["hemoglobin", "hematocrit", "platelets", "wbc", "ferritin"]},
    {"id": "skeletal_muscle", "label": "Skeletal muscle", "variables": ["cpk", "myoglobin", "ldh"]}
  ],
  "systemic": {
    "label": "Systemic / not organ-attributed",
    "variables": ["temperature", "crp", "crp_hs", "esr"]
  }
}
