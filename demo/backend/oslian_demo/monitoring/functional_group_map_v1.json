    {"id": "renal_urinary", "label": "Renal clearance / urinary",
     "module_variables": ["bun", "creatinine", "uric_acid", "urine_output"],
     "primary": ["creatinine", "bun", "urine_output"], "secondary": ["uric_acid"],
     "related": ["potassium", "sodium", "chloride", "bicarbonate", "map"], "organs": ["kidneys"]},
    {"id": "acid_base_electrolyte", "label": "Acid–base / electrolytes",
