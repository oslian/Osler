     "primary": ["hemoglobin", "hematocrit", "platelets"], "secondary": ["inr", "ptt", "fibrinogen"],
     "related": ["wbc", "albumin"], "organs": ["bone_marrow", "spleen", "liver"]},
    {"id": "immune_inflammatory", "label": "Immune / inflammatory",
     "module_variables": ["crp", "crp_hs", "esr", "ferritin", "temperature", "wbc"],
     "primary": ["wbc", "temperature", "crp"], "secondary": ["crp_hs", "esr", "ferritin"],
