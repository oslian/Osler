  "organ_primary_function": {
    "heart": "cardiovascular_perfusion", "blood_vessels": "cardiovascular_perfusion", "lungs": "respiratory",
    "kidneys": "renal_urinary", "liver": "hepatic_synthetic", "pancreas": "endocrine_metabolic",
    "stomach": "gastrointestinal_pancreatic", "intestines": "gastrointestinal_pancreatic",
