# Copy to .env and fill in locally. .env is git-ignored; never commit real values.
# Every variable is optional: with none of them set the demo runs in detached mode
# on 127.0.0.1:5000 with its SQLite ledger under var/.

# ---- server ----------------------------------------------------------------
OSLIAN_HOST=127.0.0.1
OSLIAN_PORT=5000
OSLIAN_STREAM_DB=var/oslian_stream.sqlite3

# ---- access (docs/SECURITY.md) --------------------------------------------
# off  = no sign-in; the server then refuses any bind address but loopback.
# oidc = sign in through the identity provider below; every other value here is then required.
OSLIAN_AUTH=off
OSLIAN_PUBLIC_URL=
OSLIAN_OIDC_ISSUER=
OSLIAN_OIDC_CLIENT_ID=
OSLIAN_OIDC_CLIENT_SECRET=
OSLIAN_SESSION_SECRET=
# Optional: only members of this directory group (the "groups" claim) may sign in.
OSLIAN_OIDC_REQUIRED_GROUP=
OSLIAN_IDLE_MINUTES=15
OSLIAN_AUDIT_DB=var/oslian_audit.sqlite3
# The address of the TLS proxy in front of this server. Only it may name the client's address and scheme.
OSLIAN_TRUSTED_PROXY=
# May text typed in Medication Safety leave for OpenAI or Gemini? Defaults to on without sign-in, off with it.
OSLIAN_EXTERNAL_LLM=

# ---- stream event log (printed to the console that runs the server) --------
OSLIAN_STREAM_LOG=events
OSLIAN_STREAM_LOG_FORMAT=pretty
OSLIAN_STREAM_LOG_PAYLOAD=summary

# ---- forecast runtime -----------------------------------------------------
# detached = no forecasts: every cell is degraded with a null point.
# api      = call the forecast API in api/ of this repository.
OSLIAN_FORECAST_RUNTIME=detached
OSLIAN_FORECAST_API_URL=http://127.0.0.1:8000
# The API's OSLER_API_TOKEN. Required, with an https URL, when the API runs on another machine.
OSLIAN_FORECAST_API_TOKEN=

# ---- Epic FHIR boundary (contract only; nothing is read from here today) ----
OSLIAN_EPIC_PRIVATE_KEY_PEM=

# ---- Medication Safety free-text parsing and chat (optional) ---------------
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
